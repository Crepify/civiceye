# ------------------------------------------------------------------
# CivicEye / Amrita Eye environment variables
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# --- Supabase (REQUIRED for login + real data) ----------------------
# Create a free project at https://supabase.com → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Google Maps (optional; app falls back to the built-in map) ----
VITE_GOOGLE_MAPS_API_KEY=

# --- REAL image AI (optional; free, no card) -----------------------
# Roboflow is the PRIMARY engine; Groq is the backup. No Gemini.
# Groq (backup real engine): free key at https://console.groq.com
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=qwen/qwen3.6-27b
# Note: in Groq console, enable the qwen vision model under Settings → Project limits

# Roboflow (real object detection): free at roboflow.com — key at app.roboflow.com/settings/api
VITE_ROBOFLOW_API_KEY=

# Roboflow PROXY (recommended — Cloudflare Worker, 30s timeout; see worker/README.md):
# Without this the app uses the Vercel /api/roboflow function (10s Hobby limit).
VITE_ROBOFLOW_PROXY_URL=

# Roboflow WORKFLOW (primary — "CivicEye Pothole Reporting Starter"):
# workspace slug + workflow slug from the workflow's run endpoint:
#   https://serverless.roboflow.com/{workspace}/workflows/{workflow_id}
# Declared input: image (sent as base64). Response includes the annotated
# image PLUS detections: predictions, filtered_predictions, primary_issue,
# severity, issue_classes (Pothole, Garbage Accumulation, Broken Street Light, …).
VITE_ROBOFLOW_WORKSPACE=
VITE_ROBOFLOW_WORKFLOW_ID=

# Roboflow STANDARD DETECT (alternative — returns per-box confidence):
# model = the "model/version" path from a model's "Use via API" tab (e.g. pothole-detection/1)
# or a full detect.roboflow.com URL. Used only when the workflow vars above are empty.
VITE_ROBOFLOW_MODEL=

# Order tried: Roboflow → Groq → built-in estimate

# --- Public origin (used for magic-link redirects + QR uploads) ----
# Leave empty to auto-detect from the browser.
VITE_APP_URL=

# Comma separated list of mock authorities (dashboard assignment).
VITE_AUTHORITIES=BBMP Ward 42,BWSSB,BESCOM,Traffic Police,Forest Dept.
